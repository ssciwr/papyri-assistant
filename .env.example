LLM_API_KEY=your-provider-key
LLM_API_URL=https://your-provider.example/v1
LLM_MODEL=your-chat-model

# Embedding credentials are required only when database metadata selects the
# corresponding provider. VLLM_API_KEY may remain empty for an unauthenticated
# OpenAI-compatible server.
OPENAI_API_KEY=
VOYAGE_API_KEY=
MISTRAL_API_KEY=
VLLM_API_KEY=
HF_TOKEN=

# Scrapyrus publishes endpoint profile "vllm" by default for self-hosted,
# OpenAI-compatible embedding servers. The URL must be reachable from the
# backend container. For another profile, add EMBEDDING_ENDPOINT_<PROFILE> here
# and forward that concrete variable in both Compose files.
EMBEDDING_ENDPOINT_VLLM=https://your-vllm-embedding-server.example/v1

BACKEND_PORT=3001
VITE_WARNING_BANNER_TEXT=
POSTGRES_DATA_DIR=./data/postgres
# Use URL-safe characters so this value can be embedded in POSTGRES_URL.
PAPYRI_QUERY_PASSWORD=replace-with-a-long-random-password
# Host-side processes use the development port published by compose.yaml.
# Compose overrides this inside the backend container with postgres:5432.
POSTGRES_URL=postgresql://papyri_query_reader:${PAPYRI_QUERY_PASSWORD}@127.0.0.1:55432/scrapyrus

# Development compose defaults to CORS_ORIGIN=http://localhost:5173 and
# VITE_API_URL=http://localhost:3001 when these are unset.
# Production compose defaults to PROD_VITE_API_URL=/api so nginx can proxy requests.
# CORS_ORIGIN=https://your-domain.example
# PROD_VITE_API_URL=/api

FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
TLS_CERTIFICATE_PATH=./certs/tls.pem
TLS_PRIVATE_KEY_PATH=./certs/tls.key
